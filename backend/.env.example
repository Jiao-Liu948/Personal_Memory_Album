# ==================================================
# Personal Memory Agent 环境变量模板
# 用法：复制本文件为 backend/.env 并填入真实值
#   cp .env.example .env
# ==================================================

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=personal_agent

# ---------- 对话主模型（OpenAI 兼容接口） ----------
MODEL_NAME=your_chat_model
MODEL_API_KEY=your_api_key
MODEL_BASE_URL=https://your-openai-compatible-endpoint/v1

# ---------- 视觉多模态模型 ----------
VISION_MODEL_NAME=your_vision_model
VISION_MODEL_API_KEY=your_api_key
VISION_MODEL_BASE_URL=https://your-openai-compatible-endpoint/v1

# ---------- 评测裁判模型（可选，未配置时回退到主模型） ----------
JUDGE_MODEL_NAME=
JUDGE_MODEL_API_KEY=
JUDGE_MODEL_BASE_URL=

# ---------- Embedding 向量模型 ----------
EMBEDDING_MODEL_NAME=your_embedding_model
EMBEDDING_API_KEY=your_api_key
EMBEDDING_BASE_URL=https://your-openai-compatible-endpoint/v1

# ---------- Langfuse 观测（可选，不配置则自动关闭埋点） ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------- 存储与向量库 ----------
STORAGE_ROOT=./storage/photos
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION=memory_facts

# ---------- 调用健壮性（可选） ----------
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
VISION_TIMEOUT=60

# ---------- 调试 ----------
DEBUG=false
